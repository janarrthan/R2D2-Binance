<div class="header">
  <h2>Signals</h2>
  <button class="btn btn-primary" id="btn-add" onclick="showModal('create-modal')">Add +</button>
</div>

<div class="table-wrapper">
  <table class="table">
    <thead>
      <tr>
        <th>Date</th>
        <th>Channel</th>
        <th>Coin Name</th>
        <th>Direction</th>
        <th>Entry Price</th>
        <th>Target</th>
        <th>Stop Loss</th>
        <th>Status</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody id="table-body">

    </tbody>
  </table>
</div>

<div class="modal fade" tabindex="-1" id="create-modal" role="dialog">
  <div class="modal-dialog" role="document" style="max-width: 1000px;">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Add Signal</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>

      <div class="modal-body">
        <form id="add-form">
          <div class="row">
            <div class="col-lg-3">
              <div class="form-group">
                <label for="coinName">Coin Name</label>
                <input type="text" name="coinName" id="coinName" class="form-control" />
              </div>

              <div class="form-group">
                <label for="direction">Direction</label>
                <select class="form-control" id="direction" name="direction">
                  <option value="" disabled selected> Select Direction</option>
                  <option value="Long">Long</option>
                  <option value="Short">Short</option>
                </select>
              </div>

              <div class="form-group">
                <label for="dateAdded">Date Added</label>
                <input type="datetime-local" name="dateAdded" id="dateAdded" class="form-control" />
              </div>

              <div class="form-group">
                <label for="status">Status</label>
                <select class="form-control" id="status" name="status">
                  <option value="" disabled selected>Select Status</option>
                  <option value="Active">Active</option>
                  <option value="Complete">Complete</option>
                </select>
              </div>
            </div>
            <div class="col-lg-6" style="border-right: 2px solid black;">

              <div class="form-group">
                <label for="entryPrice">Entry Price</label>
                <input type="number" name="entryPrice" id="entryPrice" class="form-control" />
              </div>

              <div class="form-group">
                <label for="targetPrice">Target</label>
                <input type="number" name="targetPrice" id="targetPrice" class="form-control" />
              </div>

              <div class="form-group">
                <label for="stopLoss">Stop Loss</label>
                <input type="number" name="stopLoss" id="stopLoss" class="form-control" />
              </div>
            </div>
            <div class="col-lg-3">

              <div class="form-group form-check mt-3">
                <input type="checkbox" class="form-check-input" id="isCreateTrade" />
                <label class="form-check-label" for="isCreateTrade">Create Trade</label>
              </div>
              <div class="form-group form-check mt-3">
                <input type="checkbox" class="form-check-input" id="isSendMessage" />
                <label class="form-check-label" for="isSendMessage">Send Message</label>
              </div>
            </div>
          </div>

          <div class="modal-footer mt-4">
            <button type="submit" class="btn btn-primary" id="add-product">Save changes</button>
            <button type="button" class="btn btn-secondary" data-dismiss="modal" data-target="#exampleModal">Close</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" tabindex="-1" id="details-modal" role="dialog">
  <div class="modal-dialog" role="document" style="max-width: 800px;">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Signal Details</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>

      <div class="modal-body">
        <div class="row">
          <div class="col" id="left-details">

          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="/js/models/signal.js"></script>