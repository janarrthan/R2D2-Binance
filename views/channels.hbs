                <label class="form-check-label" for="isListenToNewMessages">Listen To New Messages</label>
              </div>
            </div>
          </div>

          <div class="modal-footer mt-4">
            <button type="submit" class="btn btn-primary" id="add-product">Save changes</button>
            <button
              type="button"
              class="btn btn-secondary"
              data-dismiss="modal"
              data-target="#exampleModal"
            >Close</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="/js/models/channel.js"></script>