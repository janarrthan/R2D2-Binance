<div class="header">
  <h2>Strategies</h2>

  <div class="dropdown dropleft">
    <button
      class="btn btn-secondary dropdown-toggle"
      type="button"
      id="btn-add"
      data-toggle="dropdown"
      aria-haspopup="true"
      aria-expanded="false"
    >
      Add +
    </button>
    <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
      <a class="dropdown-item" href="#" onclick="showModal('create-normal-trade-modal')">Add Normal Trade Strategy</a>
      <a class="dropdown-item" href="#" onclick="showModal('create-opposite-trade-modal')">Add Opposite Trade Strategy</a>
      <a class="dropdown-item" href="#" onclick="showModal('create-perc-entry-trade-modal')">Add Percentage Entry Normal
        Trade Strategy</a>
    </div>
  </div>
</div>

<div class="table-wrapper">
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Channel</th>
        <th>Type</th>
        <th>Strategy For</th>
        <th>Strategy Type</th>
        <th>Status</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody id="table-body">

    </tbody>
  </table>
</div>

{{! =================================== Create Modals ============================= }}
<div class="modal fade" tabindex="-1" id="create-normal-trade-modal" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Add Normal Trade Strategy</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>

      <div class="modal-body">
        <form id="normal-trade-form" enctype="multipart/form-data">
          <div class="row">
            <div class="col-lg-6">
              <div class="form-group">
                <label for="strategyName">Strategy Name</label>
                <input type="text" name="strategyName" id="strategyName" class="form-control" />
              </div>

              <div class="form-group">
                <label for="channel">Channel</label>
                <select class="form-control" id="channel" name="channel">
                  <option value="" disabled selected>Select Channel</option>
                  {{#each channels}}
                    <option value="{{_id}}">{{channelName}}</option>
                  {{/each}}
                </select>
              </div>

              <div class="form-group">
                <label for="strategyFor">Strategy For</label>
                <select class="form-control" id="strategyFor" name="strategyFor">
                  <option value="" disabled selected>Select Strategy For</option>
                  <option value="Long">Long</option>
                  <option value="Short">Short</option>
                </select>
              </div>

              <div class="form-group">
                <label for="strategyType">Strategy Type</label>
                <select class="form-control" id="strategyType" name="strategyType">
                  <option value="" disabled selected>Select Strategy Type</option>
                  <option value="normal">Normal</option>
                  <option value="stopLossMoveToEntry">Stop Loss Move To Entry</option>
                </select>
              </div>

              <div class="form-group mt-3">
                <label for="status">Status</label>
                <select class="form-control" id="status" name="status">
                  <option value="Active">Active</option>
                  <option value="Blocked">Blocked</option>
                </select>
              </div>
            </div>

            <div class="col-lg-6">
              <div class="form-group">
                <label for="selectedTargetNo">Selected Target No</label>
                <input type="number" name="selectedTargetNo" id="selectedTargetNo" class="form-control" />
              </div>

              <div class="form-check mt-3">
                <input class="form-check-input" type="checkbox" value="" id="isPlaceTradeIfTargetDoesntExist" />
                <label class="form-check-label" for="isPlaceTradeIfTargetDoesntExist">
                  Place trade if target doesnt exist (uses the maximum available target).
                </label>
              </div>

              <div class="form-group mt-3">
                <label for="tradeCancelTargetNo">Trade Cancel Target No</label>
                <input type="number" name="tradeCancelTargetNo" id="tradeCancelTargetNo" class="form-control" />
              </div>

              <div class="form-group mt-3">
                <label style="display: block;">Excluded Days</label>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="checkbox" id="excludedDays" value="1" />
                  <label class="form-check-label" for="">Mon</label>
                </div>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="checkbox" id="excludedDays" value="2" />
                  <label class="form-check-label" for="">Tues</label>
                </div>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="checkbox" id="excludedDays" value="3" />
                  <label class="form-check-label" for="">Wed</label>
                </div>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="checkbox" id="excludedDays" value="4" />
                  <label class="form-check-label" for="">Thurs</label>
                </div>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="checkbox" id="excludedDays" value="5" />
                  <label class="form-check-label" for="">Fri</label>
                </div>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="checkbox" id="excludedDays" value="6" />
                  <label class="form-check-label" for="">Sat</label>
                </div>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="checkbox" id="excludedDays" value="0" />
                  <label class="form-check-label" for="">Sun</label>
                </div>
              </div>

              <div class="form-check mt-3">
                <input class="form-check-input" type="checkbox" value="" id="isExclRepeatTrades" />
                <label class="form-check-label" for="isExclRepeatTrades">
                  Exclude Repeated Trades
                </label>
              </div>

              <div class="form-group mt-3">
                <label for="excludedDates" style="display: block;">Excluded Dates (Seperated by comma) (Use 100 when you
                  want to include the last date of every month)</label>
                <input type="text" name="excludedDates" id="excludedDates" class="form-control" />
              </div>
            </div>
          </div>

          <div class="modal-footer mt-4">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <button
              type="button"
              class="btn btn-secondary"
              data-dismiss="modal"
              data-target="#create-normal-trade-modal"
            >Close</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

