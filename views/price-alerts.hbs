<div class="header">
  <h2>Price Alerts</h2>
  <button class="btn btn-primary" id="btn-add" onclick="showModal('create-modal')">Add +</button>
</div>

<div class="table-wrapper">
  <table class="table">
    <thead>
      <tr>
        <th>Coin Name</th>
        <th>Target Price</th>
        <th>Direction</th>
        <th>Date Added</th>
        <th>Note</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody id="table-body">

    </tbody>
  </table>
</div>

<div class="modal fade" tabindex="-1" id="create-modal" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Add Alert</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>

      <div class="modal-body">
        <form id="add-form">
          <div class="row">
            <div class="col-lg-6">
              <div class="form-group">
                <label for="coinName">Coin Name</label>
                <input type="text" name="coinName" id="coinName" class="form-control" />
              </div>

              <div class="form-group">
                <label for="targetPrice">Target Price</label>
                <input type="number" class="form-control" name="targetPrice" id="targetPrice" />
              </div>

              <div class="form-group">
                <label for="direction">Direction</label>
                <select class="form-control" name="direction" id="direction">
                  <option selected disabled value="">Select Direction</option>
                  <option value="up">UP</option>
                  <option value="down">Down</option>
                </select>
              </div>
            </div>

            <div class="col-lg-6">
              <div class="form-group">
                <label for="dateAdded">Date Added</label>
                <input type="date" class="form-control" name="dateAdded" id="dateAdded" />
              </div>

              <div class="form-group">
                <label for="note">Note</label>
                <textarea class="form-control" name="note" id="note" rows="3"></textarea>
              </div>
            </div>
          </div>

          <div class="modal-footer mt-4">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <button
              type="button"
              class="btn btn-secondary"
              data-dismiss="modal"
              data-target="#create-modal"
            >Close</button>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>

<script src="/js/models/price-alerts.js"></script>