<div class="header">
  <h2>Orders
    <span style="font-size: 18px;">{{signal.dateAdded}}
      ||
      {{signal.coinName}}
      ||
      {{signal.direction}}
      || Entry:
      {{signal.entryPrice}}
      || Target:
      {{signal.targetPrice}}
      || Stop Loss:
      {{signal.stopLoss}}
      ||
      {{signal.status}}
    </span>
  </h2>

  <div>
    {{! <button class="btn btn-primary" id="btn-save-order" onclick="showModal('save-modal')">Save Order</button> }}
    <button class="btn btn-primary" id="btn-add" onclick="showModal('create-modal')">Create Order</button>

    <button class="btn btn-danger" id="btn-delete-all" onclick="initiateCancellAll('{{signal._id}}')">Cancell All</button>
  </div>
</div>

<input type="hidden" id="signalId" value="{{signal._id}}" />
<input type="hidden" id="entryPrice" value="{{signal.entryPrice}}" />

<div class="table-wrapper">
  <table class="table">
    <thead>
      <tr>
        <th>Client Name</th>
        <th>Quantity</th>
        <th>Trade Amount</th>
        <th>Status</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody id="table-body">

    </tbody>
  </table>
</div>

<div class="modal fade" tabindex="-1" id="create-modal" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Add Order</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>

      <div class="modal-body">
        <form id="add-form">
          <div class="row">
            <div class="col">
              <div class="form-group">
                <label for="usersEmails">Users Email</label>
                <br />
                <textarea name="usersEmails" id="usersEmails" style="width: 100%;" rows="5"></textarea>
              </div>
            </div>
          </div>

          <div class="modal-footer mt-4">
            <button type="submit" class="btn btn-primary" id="add-product">Save changes</button>
            <button
              type="button"
              class="btn btn-secondary"
              data-dismiss="modal"
              data-target="#exampleModal"
            >Close</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" tabindex="-1" id="save-modal" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Save Order</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>

      <div class="modal-body">
        <form id="save-form">
          <div class="row">
            <div class="col">
              <div class="form-group">
                <label for="email">User Email</label>
                <br />
                <input type="email" name="email" id="email" class="form-control" />
              </div>

              <div class="form-group">
                <label for="bybitOrderId">Bybit Order Id</label>
                <br />
                <input type="text" name="bybitOrderId" id="bybitOrderId" class="form-control" />
              </div>
            </div>
          </div>

          <div class="modal-footer mt-4">
            <button type="submit" class="btn btn-primary" id="add-product">Save changes</button>
            <button
              type="button"
              class="btn btn-secondary"
              data-dismiss="modal"
              data-target="#exampleModal"
            >Close</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="/js/models/order.js"></script>