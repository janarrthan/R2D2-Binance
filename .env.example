# Runtime
ENVIRONMENT=dev            # "dev" enables audible alerts and verbose error logging
PORT=3000

# Express session
SESSION_SECRET=change-me-to-a-long-random-string

# MongoDB
LOCAL_DB=mongodb://127.0.0.1:27017/r2d2-binance
NOTIF_DB=mongodb://127.0.0.1:27017/r2d2-notifications

# Brevo SMTP (login + alert emails)
SMTP_KEY=your-brevo-smtp-key
BREVO_AUTH=your-brevo-smtp-login
BREVO_EMAIL=sender@example.com
BREVO_RECEIVER_EMAIL=you@example.com

# Initial dashboard admin (seeded by cronJob.createAdminUser)
AUTH_EMAIL=admin@example.com
AUTH_PASSWORD=change-me
